* ============================================================================
*  Польові транзистори з керуючим p-n переходом (JFET)
* ============================================================================

* --- BF245B: n-канальний JFET, IDSS=6..15 мА, UЗВ(відс)=-0,25..-8 В (Philips) ---
.MODEL BF245B NJF (VTO=-3.21 BETA=3.05M LAMBDA=8.86M RD=258
+ RS=184 IS=5.64F PB=1 FC=.5 CGS=3.85P CGD=1.15P)

* --- 2SK170: малошумний n-канальний JFET (Toshiba, модель diyAudio) ---
.MODEL 2SK170 NJF(Beta=59.86m Rs=4.151 Rd=4.151 Lambda=1.923m
+Vto=-.5024 Cgd=20p Pb=.4746 Fc=.5
+Cgs=25.48p Is=8.477p
+Kf=111.3E-18 Af=1)

* --- J-FET p-канальний 2SJ74 (Toshiba, модель diyAudio) ---
.MODEL 2SJ74 PJF(Beta=92.12m Rs=7.748 Rd=7.748 Lambda=4.464m
+Vto=-.5428 Cgd=85.67p Pb=.3905 Fc=.5
+Cgs=78.27p Is=12.98p
+Kf=26.64E-18 Af=1)
